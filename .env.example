# SQLite database file (created by `npm run db:setup`)
DATABASE_URL="file:./dev.db"

# Optional. Set these to the store's real Pix details before using them.
PIX_CHAVE=""
PIX_CIDADE="FORTALEZA"

# Admin access: use a password with at least 12 characters and a random secret of 32+ characters.
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""
CUSTOMER_SESSION_SECRET=""

# Gmail SMTP: create a Google App Password and keep it only in .env or hosting secrets.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
