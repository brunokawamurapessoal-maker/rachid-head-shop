# Supabase PostgreSQL. Use the transaction pooler for app requests and the
# session pooler for migrations. Keep both URLs private.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[URL_ENCODED_PASSWORD]@[POOLER_HOST]:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[URL_ENCODED_PASSWORD]@[POOLER_HOST]:5432/postgres?sslmode=require"

# Optional. Set these to the store's real Pix details before using them.
PIX_CHAVE=""
PIX_CIDADE="FORTALEZA"

# Admin access: use a password with at least 12 characters and a random secret of 32+ characters.
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""
CUSTOMER_SESSION_SECRET=""

# Gmail SMTP: create a Google App Password and keep it only in .env or hosting secrets.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
