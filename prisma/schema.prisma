generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id       String    @id
  name     String
  icon     String
  products Product[]
}

model Product {
  id             String      @id @default(cuid())
  slug           String      @unique
  name           String
  description    String
  priceInCents   Int
  costInCents    Int?
  imageUrls      String      @default("")
  promotionPercent Int       @default(0)
  stock          Int         @default(0)
  minStock       Int         @default(5)
  badge          String      @default("")
  icon           String
  active         Boolean     @default(true)
  categoryId     String
  category       Category    @relation(fields: [categoryId], references: [id])
  orderItems     OrderItem[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([categoryId, active])
}

model Order {
  id                String      @id @default(cuid())
  status            String      @default("pendente")
  customerId        String?
  customerName      String
  customerEmail     String
  customerPhone     String
  postalCode        String
  address           String      @default("")
  addressNumber     String      @default("")
  neighborhood      String      @default("")
  deliveryReference String      @default("")
  city              String
  state             String
  shippingMethod    String
  shippingPending   Boolean     @default(false)
  stockDeducted    Boolean     @default(false)
  inventoryTracked Boolean     @default(false)
  paymentMethod     String
  cashChangeForInCents Int      @default(0)
  subtotalInCents   Int
  shippingInCents   Int
  discountInCents   Int
  totalInCents      Int
  customer          Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items             OrderItem[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([createdAt])
  @@index([customerId, createdAt])
}

model OrderItem {
  id                String   @id @default(cuid())
  orderId           String
  productId         String?
  productName       String
  quantity          Int
  unitPriceInCents  Int
  unitCostInCents   Int?
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model StoreSettings {
  id            String   @id @default("main")
  name          String   @default("Rachid Head Shop")
  legalName     String   @default("")
  document      String   @default("")
  email         String   @default("")
  phone         String   @default("")
  whatsapp      String   @default("")
  postalCode    String   @default("")
  address       String   @default("")
  city          String   @default("Fortaleza")
  state         String   @default("CE")
  instagram     String   @default("")
  updatedAt     DateTime @updatedAt
}

model Customer {
  id                String   @id @default(cuid())
  name              String
  email             String   @unique
  phone             String
  passwordHash      String
  sessionVersion    Int      @default(0)
  cpfHash           String?  @unique
  postalCode        String   @default("")
  address           String   @default("")
  addressNumber     String   @default("")
  neighborhood      String   @default("")
  deliveryReference String   @default("")
  city              String   @default("")
  state             String   @default("")
  orders            Order[]
  recoveryRequests  CustomerRecoveryRequest[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model CustomerRecoveryRequest {
  id            String    @id @default(cuid())
  customerId    String?
  emailHash     String
  ipHash        String
  tokenHash     String?
  attempts      Int       @default(0)
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime  @default(now())
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([emailHash, createdAt])
  @@index([ipHash, createdAt])
  @@index([tokenHash])
}

model DeliveryZone {
  id           String   @id @default(cuid())
  name         String
  postalCodeStart String
  postalCodeEnd   String
  priceInCents Int
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active, postalCodeStart, postalCodeEnd])
}
